// Account Command Center — Prisma schema.
// Conventions (see CLAUDE.md):
//  * Enum-like columns are String, validated by Zod enums in src/lib/domain/enums.ts
//    (SQLite has no native enums; this stays Postgres-compatible).
//  * List / structured columns use Json (supported on SQLite and Postgres).
//  * isDemo marks synthetic seed rows so the UI can show the DEMO DATA badge.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                  String    @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId             String    @default("local")
  teamId              String    @default("local-team")
  createdBy           String    @default("local")
  updatedBy           String    @default("local")
  name                String
  domain              String?
  ticker              String?
  cik                 String?
  lei                 String?
  wikidataId          String?
  /// Set when the user confirms which legal entity this account is (identity resolution).
  identityConfirmedAt DateTime?
  fiscalYearEnd       String? // "MMDD" from SEC (or entered by the user)
  industry            String
  subIndustry         String?
  hq                  String?
  employeeBand        String?
  revenueBand         String?
  tier                String // Strategic | Growth | Maintain
  ownerNotes          String?
  healthScore         Float     @default(0)
  whitespaceScore     Float     @default(0)
  isDemo              Boolean   @default(false)
  sourceConfig        Json? // { googleNews, greenhouseSlug, leverSlug, rssFeeds[] }
  lastTouchAt         DateTime?
  nextTouchAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  contacts       Contact[]
  initiatives    Initiative[]
  techStack      TechStackHypothesis[]
  signals        Signal[]
  opportunities  Opportunity[]
  touches        Touch[]
  practiceStatus AccountPracticeStatus[]
  planItems      AccountPlanItem[]
  eventInvites   EventInvite[]
  campaigns      Campaign[]
  partnerReps    PartnerRepAccount[]
  tasks          Task[]
  meetings       Meeting[]
  registrations  PartnerRegistration[]
  fields         AccountField[]
  fieldHistory   AccountFieldHistory[]
  proposals      FieldProposal[]
  enrichRuns     EnrichmentRun[]
  enrichJobs     EnrichmentJob[]
  financials     FinancialFact[]
  relations      CorporateRelation[]
  businessCases  BusinessCase[]

  @@index([tier])
  @@index([name])
}

model AccountPracticeStatus {
  id           String  @id @default(cuid())
  accountId    String
  practiceArea String
  status       String // NotEngaged | Exploring | ActiveOpp | Delivered
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, practiceArea])
}

model Contact {
  id          String  @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId     String  @default("local")
  teamId      String  @default("local-team")
  createdBy   String  @default("local")
  updatedBy   String  @default("local")
  accountId   String
  title       String
  function    String
  seniority   String // C-Level | VP | Director | Manager | IC
  buyingRole  String // EconomicBuyer | Champion | Technical | Influencer | Blocker
  displayName String? // user-entered, or an accepted public suggestion (SEC filing) with sourceUrl
  source      String? // null = user-entered | "sec-officers" (accepted suggestion)
  sourceUrl   String?
  reportsToId String?
  engagement  String  @default("None") // None | Light | Engaged | Strong
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Initiative {
  id            String  @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId       String  @default("local")
  teamId        String  @default("local-team")
  createdBy     String  @default("local")
  updatedBy     String  @default("local")
  accountId     String
  title         String
  description   String?
  practiceAreas Json // string[]
  evidence      String? // short supporting excerpt (never whole sections)
  section       String? // e.g. "10-K Item 1A"
  source        String // seed | signal | filing | job-post | user-hypothesis
  sourceUrl     String?
  signalId      String?
  confidence    Float
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model TechStackHypothesis {
  id         String  @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId    String  @default("local")
  teamId     String  @default("local-team")
  createdBy  String  @default("local")
  updatedBy  String  @default("local")
  accountId  String
  category   String
  technology String
  evidence   String
  sourceUrl  String?
  source     String // seed | job-post | filing | news | dns | web | user-hypothesis
  confidence Float
  status     String  @default("hypothesis") // hypothesis | confirmed | rejected
  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Signal {
  id             String    @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId        String    @default("local")
  teamId         String    @default("local-team")
  createdBy      String    @default("local")
  updatedBy      String    @default("local")
  accountId      String
  type           String
  title          String
  summary        String?
  url            String?
  source         String // adapter id
  publishedAt    DateTime
  dedupeHash     String    @unique
  practiceTags   Json // string[]
  tagIndex       String    @default("") // ",ai-infra,cloud," — portable LIKE filter (Json array filters aren't portable)
  relevance      Float
  relevanceParts Json // { recency, sourceWeight, practiceMatch, tierFactor }
  read           Boolean   @default(false)
  starred        Boolean   @default(false)
  dismissed      Boolean   @default(false)
  inNextSummary  Boolean   @default(false)
  /// Phase 7 triage: when and how the signal was handled in the triage queue.
  triagedAt      DateTime?
  triageAction   String? // read | starred | dismissed | play | opportunity | note | task
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, publishedAt])
  @@index([publishedAt])
  @@index([relevance])
  @@index([createdAt])
  @@index([source])
  @@index([type])
}

model Opportunity {
  id               String                  @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId          String                  @default("local")
  teamId           String                  @default("local-team")
  createdBy        String                  @default("local")
  updatedBy        String                  @default("local")
  accountId        String
  name             String
  practiceArea     String
  stage            String
  amount           Float
  closeDate        DateTime
  probability      Int
  forecastCategory String // Pipeline | BestCase | Commit | Closed | Omitted
  nextStep         String?
  nextStepDate     DateTime?
  meddpicc         Json
  partners         Json // string[]
  competitors      Json // string[]
  closeDatePushes  Int                     @default(0)
  stageChangedAt   DateTime
  closedAt         DateTime?
  sourceSignalId   String?
  isDemo           Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  account          Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tasks            Task[]
  partnerReps      OpportunityPartnerRep[]
  registrations    PartnerRegistration[]
  stageHistory     StageChange[]

  @@index([stage])
  @@index([closeDate])
  @@index([accountId])
}

model StageChange {
  id            String      @id @default(cuid())
  opportunityId String
  fromStage     String?
  toStage       String
  changedAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model Play {
  id                 String     @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId            String     @default("local")
  teamId             String     @default("local-team")
  createdBy          String     @default("local")
  updatedBy          String     @default("local")
  slug               String     @unique
  name               String
  practiceArea       String
  targetPersonas     Json
  triggerKeywords    Json
  triggerSignalTypes Json
  valueHypothesis    String
  talkTrack          Json
  sequence           Json // [{ day, channel, description }]
  assetsNeeded       Json
  successMetrics     Json
  origin             String     @default("user") // starter | user | imported
  isDemo             Boolean    @default(false)
  campaigns          Campaign[]
}

model Campaign {
  id        String   @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId   String   @default("local")
  teamId    String   @default("local-team")
  createdBy String   @default("local")
  updatedBy String   @default("local")
  name      String
  accountId String?
  playId    String?
  status    String // planned | active | complete | paused
  startDate DateTime
  isDemo    Boolean  @default(false)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  play      Play?    @relation(fields: [playId], references: [id])
  touches   Touch[]
}

model Touch {
  id             String    @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId        String    @default("local")
  teamId         String    @default("local-team")
  createdBy      String    @default("local")
  updatedBy      String    @default("local")
  accountId      String
  campaignId     String?
  channel        String // email | linkedin | call | meeting | event | briefing
  persona        String
  angle          String?
  scheduledAt    DateTime
  completedAt    DateTime?
  outcome        String? // replied | meeting | opp-created | no-response
  sourceSignalId String?
  /// Joint touch with a partner rep (co-sell tracker).
  partnerRepId   String?
  isDemo         Boolean   @default(false)
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaign       Campaign? @relation(fields: [campaignId], references: [id])

  @@index([accountId, scheduledAt])
  @@index([scheduledAt])
}

model Event {
  id        String        @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId   String        @default("local")
  teamId    String        @default("local-team")
  createdBy String        @default("local")
  updatedBy String        @default("local")
  name      String
  kind      String // conference | webinar | partner | briefing | roundtable
  startsAt  DateTime
  location  String?
  isDemo    Boolean       @default(false)
  invites   EventInvite[]
}

model EventInvite {
  id        String  @id @default(cuid())
  eventId   String
  accountId String
  persona   String?
  status    String // planned | invited | registered | attended | followed-up
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AccountPlanItem {
  id        String    @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId   String    @default("local")
  teamId    String    @default("local-team")
  createdBy String    @default("local")
  updatedBy String    @default("local")
  accountId String
  kind      String // objective | strategy | action
  parentId  String?
  text      String
  owner     String?
  dueDate   DateTime?
  status    String    @default("open")
  sortOrder Int       @default(0)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Note {
  id           String   @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId      String   @default("local")
  teamId       String   @default("local-team")
  createdBy    String   @default("local")
  updatedBy    String   @default("local")
  entityType   String // account | opportunity | signal | play | event
  entityId     String
  body         String
  internalOnly Boolean  @default(true)
  tags         Json? // string[] (quick capture)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([entityType, entityId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  summary    String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model SavedView {
  id        String @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId   String @default("local")
  teamId    String @default("local-team")
  createdBy String @default("local")
  updatedBy String @default("local")
  scope     String
  name      String
  config    Json

  @@unique([scope, name])
}

model DashboardLayout {
  id        String  @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId   String  @default("local")
  teamId    String  @default("local-team")
  createdBy String  @default("local")
  updatedBy String  @default("local")
  name      String  @unique
  widgets   Json
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)
}

model Setting {
  key   String @id
  value Json
}

model Notification {
  id        String   @id @default(cuid())
  kind      String
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SourceRun {
  id         String    @id @default(cuid())
  adapterId  String
  startedAt  DateTime
  finishedAt DateTime?
  ok         Boolean
  itemsNew   Int       @default(0)
  error      String?

  @@index([adapterId, startedAt])
}

model JobRequest {
  id         String    @id @default(cuid())
  kind       String
  payload    Json?
  status     String    @default("pending")
  /// Structured outcome written by the worker (e.g. per-source results for "fetch-now").
  result     Json?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
}

model HttpCache {
  key       String   @id
  body      String
  etag      String?
  fetchedAt DateTime
}

model ExportTemplate {
  id     String @id @default(cuid())
  name   String @unique
  config Json
}

model ExportJob {
  id         String   @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId    String   @default("local")
  teamId     String   @default("local-team")
  createdBy  String   @default("local")
  updatedBy  String   @default("local")
  templateId String?
  title      String
  config     Json
  format     String
  status     String
  outputPath String?
  version    Int      @default(1)
  createdAt  DateTime @default(now())
}

/// DC Sandbox scenario (Phase 12). `spec` = src/modules/sandbox/lib/spec.ts (SandboxSpecSchema, version 2).
model SandboxScenario {
  id          String   @id @default(cuid())
  ownerId     String   @default("local")
  teamId      String   @default("local-team")
  createdBy   String   @default("local")
  updatedBy   String   @default("local")
  name        String
  description String?
  accountId   String?
  /// Set on what-if copies: the scenario this one was copied from (for before/after compare).
  baseId      String?
  spec        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([accountId])
}

// ── Phase 5: import batches (undoable), saved column mappings, partner reps ──

model ImportBatch {
  id        String         @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId   String         @default("local")
  teamId    String         @default("local-team")
  createdBy String         @default("local")
  updatedBy String         @default("local")
  kind      String // accounts | contacts | opportunities | notes | partner-reps
  fileName  String?
  inputType String // csv | xlsx | paste
  status    String         @default("applied") // applied | undone
  counts    Json // { created, merged, skipped, errors }
  createdAt DateTime       @default(now())
  undoneAt  DateTime?
  /// Phase 13: batches from one data-contract import share a groupId and undo together.
  groupId   String?
  records   ImportRecord[]

  @@index([createdAt])
}

/// One row per entity an import touched; `before` holds the pre-merge snapshot used by undo.
model ImportRecord {
  id         String      @id @default(cuid())
  batchId    String
  entityType String
  entityId   String
  action     String // created | merged
  before     Json?
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model ImportMapping {
  id        String   @id @default(cuid())
  kind      String
  name      String
  mapping   Json // { fieldId: header }
  updatedAt DateTime @updatedAt

  @@unique([kind, name])
}

/// User-entered only (Phase 7.6 builds the co-sell UI on top of this).
model PartnerRep {
  id             String                  @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId        String                  @default("local")
  teamId         String                  @default("local-team")
  createdBy      String                  @default("local")
  updatedBy      String                  @default("local")
  partnerCompany String
  name           String
  title          String?
  territory      String?
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  accounts       PartnerRepAccount[]
  opportunities  OpportunityPartnerRep[]
  registrations  PartnerRegistration[]

  @@index([partnerCompany])
}

model PartnerRepAccount {
  repId     String
  accountId String
  rep       PartnerRep @relation(fields: [repId], references: [id], onDelete: Cascade)
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([repId, accountId])
}

// ── Phase 6: public-data enrichment ─────────────────────────────────────────

/// Current value of an enrichable field, with provenance. Precedence:
/// user > user-verified > high > medium > low. `locked` fields are never overwritten by enrichment.
model AccountField {
  id         String    @id @default(cuid())
  accountId  String
  field      String // e.g. "firmographics.employeeCount"
  value      Json
  source     String // "user" | enricher id
  sourceUrl  String?
  confidence String // user | verified | high | medium | low
  fetchedAt  DateTime?
  locked     Boolean   @default(false)
  updatedAt  DateTime  @updatedAt
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, field])
}

model AccountFieldHistory {
  id        String   @id @default(cuid())
  accountId String
  field     String
  oldValue  Json?
  newValue  Json?
  source    String
  sourceUrl String?
  changedAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, field])
}

/// One value proposed by an enricher. Reviewed in Account 360 → Proposed updates.
model FieldProposal {
  id              String    @id @default(cuid())
  accountId       String
  field           String
  value           Json
  enricherId      String
  source          String // human label, e.g. "SEC EDGAR"
  sourceUrl       String
  confidence      String // high | medium | low
  evidenceSnippet String?
  /// pending | accepted | rejected | applied (auto) | superseded
  status          String    @default("pending")
  fetchedAt       DateTime
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([accountId, field])
}

model EnrichmentRun {
  id         String    @id @default(cuid())
  accountId  String
  enricherId String
  startedAt  DateTime
  finishedAt DateTime?
  ok         Boolean   @default(false)
  proposals  Int       @default(0)
  error      String?
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, enricherId, startedAt])
}

/// Bulk enrichment queue (survives restarts; the worker drains it with a concurrency limit).
model EnrichmentJob {
  id          String    @id @default(cuid())
  accountId   String
  enricherIds Json? // string[]; null = all eligible
  force       Boolean   @default(false)
  status      String    @default("queued") // queued | running | done | failed | cancelled
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

/// Annual financial facts from SEC XBRL (public companies).
model FinancialFact {
  id         String   @id @default(cuid())
  accountId  String
  metric     String // revenue | netIncome | capex
  fiscalYear Int
  periodEnd  DateTime
  value      Float
  unit       String   @default("USD")
  sourceUrl  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, metric, periodEnd])
}

/// Corporate hierarchy from GLEIF / Wikidata.
model CorporateRelation {
  id              String  @id @default(cuid())
  accountId       String
  relation        String // direct-parent | ultimate-parent | subsidiary
  name            String
  lei             String?
  wikidataId      String?
  country         String?
  source          String
  sourceUrl       String
  /// Set when the user rolled this related company up as its own account.
  linkedAccountId String?
  account         Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, relation, name])
}

// ── Phase 7: daily-use features ──────────────────────────────────────────────

model Task {
  id            String       @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId       String       @default("local")
  teamId        String       @default("local-team")
  createdBy     String       @default("local")
  updatedBy     String       @default("local")
  title         String
  notes         String?
  dueDate       DateTime?
  priority      String       @default("normal") // low | normal | high | urgent
  status        String       @default("open") // open | done | cancelled
  recurrence    String? // weekly | biweekly | monthly | quarterly
  accountId     String?
  opportunityId String?
  signalId      String?
  contactId     String?
  source        String       @default("manual") // manual | signal | quick-capture | next-step | my-day
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([status, dueDate])
  @@index([accountId])
}

/// Imported from a calendar file (.ics). Only attendee DOMAINS are kept (for account matching), never addresses.
model Meeting {
  id              String    @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId         String    @default("local")
  teamId          String    @default("local-team")
  createdBy       String    @default("local")
  updatedBy       String    @default("local")
  uid             String
  title           String
  startsAt        DateTime
  endsAt          DateTime?
  location        String?
  attendeeDomains Json // string[]
  accountId       String?
  importedAt      DateTime  @default(now())
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([uid, startsAt])
  @@index([startsAt])
}

model SmartList {
  id        String   @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId   String   @default("local")
  teamId    String   @default("local-team")
  createdBy String   @default("local")
  updatedBy String   @default("local")
  name      String
  entity    String // account | opportunity | signal
  rules     Json // { match: "all" | "any", rules: [{ field, op, value }] }
  pinned    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model OpportunityPartnerRep {
  opportunityId String
  repId         String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  rep           PartnerRep  @relation(fields: [repId], references: [id], onDelete: Cascade)

  @@id([opportunityId, repId])
}

/// Deal registrations with partners (user-entered).
model PartnerRegistration {
  id             String       @id @default(cuid())
  /// Ownership (Phase 8): filled from the acting user by the db client; "local" in single-user mode.
  ownerId        String       @default("local")
  teamId         String       @default("local-team")
  createdBy      String       @default("local")
  updatedBy      String       @default("local")
  partnerCompany String
  repId          String?
  accountId      String
  opportunityId  String?
  reference      String?
  status         String       @default("submitted") // submitted | approved | rejected | expired
  expiresAt      DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  rep            PartnerRep?  @relation(fields: [repId], references: [id], onDelete: SetNull)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([partnerCompany])
}

// ── Phase 8: team-ready foundations ──

/// Local profiles. In single-user mode there is one row ("local"); teammates added here are names only
/// (used for @mentions and ownership), never contact details.
model User {
  id          String   @id @default(cuid())
  displayName String
  title       String?
  role        String   @default("associate-client-director") // see src/config/roles.ts
  teamId      String   @default("local-team")
  isSelf      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

/// Comments with @mentions on accounts and opportunities (stored locally).
model Comment {
  id         String    @id @default(cuid())
  entityType String // account | opportunity
  entityId   String
  accountId  String?
  body       String
  mentions   Json      @default("[]") // user ids
  authorId   String    @default("local")
  authorName String? // denormalized so packs keep the author when the user row isn't present
  parentId   String?
  ownerId    String    @default("local")
  teamId     String    @default("local-team")
  createdBy  String    @default("local")
  updatedBy  String    @default("local")
  createdAt  DateTime  @default(now())
  editedAt   DateTime?

  @@index([entityType, entityId])
}

/// Who did what: imports, enrichment decisions, exports, packs and deletes. Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // e.g. import.commit, enrichment.accept, export.create, pack.import, delete
  entityType String?
  entityId   String?
  summary    String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// ── Phase 11: TCO / business cases (user-entered assumptions only) ──

model BusinessCase {
  id            String                @id @default(cuid())
  ownerId       String                @default("local")
  teamId        String                @default("local-team")
  createdBy     String                @default("local")
  updatedBy     String                @default("local")
  name          String
  accountId     String?
  opportunityId String?
  /// The working model (src/lib/tco/model.ts, validated with TcoModelSchema).
  model         Json
  /// draft | final ("final" is what exports pick by default)
  status        String                @default("draft")
  version       Int                   @default(1)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  account       Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  versions      BusinessCaseVersion[]

  @@index([accountId])
  @@index([opportunityId])
}

/// A saved snapshot of a business case, for side-by-side comparison.
model BusinessCaseVersion {
  id        String       @id @default(cuid())
  caseId    String
  version   Int
  label     String?
  model     Json
  createdAt DateTime     @default(now())
  case      BusinessCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, version])
}

// ── Phase 13: data contract ──

/// Maps a sending system's record id (contract `externalId`) to the ACC record, so re-imports update in place
/// and exports can echo the sender's ids. Scoped by `system` (the contract's source.system).
model ExternalRef {
  id         String   @id @default(cuid())
  system     String
  entityType String // account | contact | opportunity | activity | note | task | partnerRep
  externalId String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([system, entityType, externalId])
  @@index([entityType, entityId])
}
