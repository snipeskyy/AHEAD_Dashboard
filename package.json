{
  "name": "account-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-env.mjs && dotenv -e .env.local -- prisma generate",
    "predev": "npm run gen:modules",
    "dev": "dotenv -e .env.local -- concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx src/worker/index.ts\"",
    "dev:web": "dotenv -e .env.local -- next dev",
    "worker": "dotenv -e .env.local -- tsx src/worker/index.ts",
    "prebuild": "npm run gen:modules",
    "build": "dotenv -e .env.local -- next build",
    "start": "dotenv -e .env.local -- concurrently -k -n web,worker \"next start\" \"tsx src/worker/index.ts\"",
    "gen:modules": "tsx scripts/gen-module-index.ts",
    "db:migrate": "dotenv -e .env.local -- tsx scripts/db-migrate.ts",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset --force --skip-seed",
    "seed": "dotenv -e .env.local -- tsx prisma/seed/run.ts",
    "setup": "npm run db:deploy && npm run seed",
    "typecheck": "npm run gen:modules && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "start:web": "dotenv -e .env.local -- next start"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "fast-xml-parser": "^5.12.0",
    "geist": "^1.9.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grid-layout": "^2.3.0",
    "seedrandom": "^3.0.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/seedrandom": "^3.0.8",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
