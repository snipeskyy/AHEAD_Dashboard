# Copy to .env.local (git-ignored). Never commit real values.

# SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Separate database for automated tests (e2e, fixtures). Tests never touch DATABASE_URL.
DATABASE_URL_TEST="file:./test.db"

# SEC EDGAR requires a descriptive User-Agent with contact info, e.g.
# "Account Command Center (personal research) your.name@example.com"
SEC_USER_AGENT=""

# Descriptive User-Agent with contact info for other public sources (Wikimedia asks for one).
# Falls back to SEC_USER_AGENT when empty.
ENRICH_USER_AGENT=""

# Public-source scheduler interval in minutes (default 30)
SCHEDULER_INTERVAL_MINUTES=30

# Set to "false" to stop the worker from making ANY outbound network calls.
PUBLIC_FETCH_ENABLED=true

# Privacy: disable framework telemetry / update pings (ACC sends no telemetry).
NEXT_TELEMETRY_DISABLED=1
CHECKPOINT_DISABLE=1

# Encrypts backups (AES-256-GCM). Generated automatically by npm install into .env.local; keep a copy.
ACC_BACKUP_KEY=""
