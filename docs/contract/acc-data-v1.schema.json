                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "description": "Reference to an account in the same file or already in ACC"
              },
              "channel": {
                "type": "string",
                "enum": [
                  "email",
                  "linkedin",
                  "call",
                  "meeting",
                  "event",
                  "briefing"
                ]
              },
              "persona": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Role or title engaged, e.g. VP Infrastructure"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}",
                "description": "ISO 8601 date or date-time"
              },
              "completed": {
                "default": true,
                "type": "boolean"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "replied",
                  "meeting",
                  "opp-created",
                  "no-response"
                ]
              },
              "summary": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "account",
              "channel",
              "persona",
              "date"
            ]
          }
