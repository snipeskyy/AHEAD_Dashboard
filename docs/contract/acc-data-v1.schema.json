{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "acc-data"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "exportedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Sending system, e.g. 'acc' or 'internal-tool'. Scopes externalIds."
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "system"
      ]
    },
    "visibility": {
      "default": "internal",
      "type": "string",
      "enum": [
        "internal",
        "customer-safe"
      ]
    },
    "entities": {
      "type": "object",
      "properties": {
        "accounts": {
          "default": [],
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "externalId": {
                "description": "The record's id in the sending system; keeps identity across re-imports",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "accId": {
                "description": "ACC's own id (present on ACC exports; ignored on import)",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sourceUrl": {
                "description": "Where the sending system found this record (a Glean result, a CRM record link). Kept as provenance.",
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              },
              "externalRefs": {
                "description": "This record's ids in other systems, keyed by system (ACC exports include ids it was imported with)",
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 80
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "domain": {
                "type": "string",
                "maxLength": 253
              },
              "ticker": {
                "type": "string",
                "maxLength": 12
              },
              "industry": {
                "type": "string",
                "maxLength": 120
              },
              "subIndustry": {
                "type": "string",
                "maxLength": 120
              },
              "hq": {
                "type": "string",
                "maxLength": 200
              },
              "tier": {
                "type": "string",
                "enum": [
                  "Strategic",
                  "Growth",
                  "Maintain"
                ]
              },
              "employeeBand": {
                "type": "string",
                "maxLength": 40
              },
              "revenueBand": {
                "type": "string",
                "maxLength": 40
              },
              "ownerNotes": {
                "description": "internal",
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "contacts": {
          "default": [],
          "maxItems": 20000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "externalId": {
                "description": "The record's id in the sending system; keeps identity across re-imports",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "accId": {
                "description": "ACC's own id (present on ACC exports; ignored on import)",
                "type": "string",
                "minLength": 1,
