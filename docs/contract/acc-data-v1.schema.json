              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "practiceArea": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Practice area id or label, e.g. modern-dc"
              },
              "stage": {
                "type": "string",
                "enum": [
                  "Qualify",
                  "Discover",
                  "Solution",
                  "Proposal",
                  "Negotiate",
                  "ClosedWon",
                  "ClosedLost"
                ]
              },
              "amount": {
                "description": "internal; omitted from customer-safe files",
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "closeDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}",
                "description": "ISO 8601 date or date-time"
              },
              "probability": {
                "description": "internal",
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "nextStep": {
                "type": "string",
                "maxLength": 500
              },
              "nextStepDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}",
                "description": "ISO 8601 date or date-time"
              }
            },
            "required": [
              "account",
              "name",
              "practiceArea",
              "stage",
              "closeDate"
            ]
          }
        },
        "activities": {
          "default": [],
