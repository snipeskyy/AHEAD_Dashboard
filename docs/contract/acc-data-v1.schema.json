                "description": "Where the sending system found this record (a Glean result, a CRM record link). Kept as provenance.",
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              },
              "externalRefs": {
                "description": "This record's ids in other systems, keyed by system (ACC exports include ids it was imported with)",
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 80
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "account": {
                "type": "object",
                "properties": {
                  "externalId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "domain": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "description": "Reference to an account in the same file or already in ACC"
              },
              "displayName": {
                "description": "Name as the user entered it; no personal contact details in this format",
                "type": "string",
                "maxLength": 120
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "function": {
                "type": "string",
                "maxLength": 80
              },
              "seniority": {
                "type": "string",
                "enum": [
                  "C-Level",
                  "VP",
                  "Director",
                  "Manager",
                  "IC"
                ]
              },
              "buyingRole": {
                "type": "string",
                "enum": [
                  "EconomicBuyer",
                  "Champion",
                  "Technical",
                  "Influencer",
                  "Blocker"
                ]
              },
              "engagement": {
                "type": "string",
                "enum": [
                  "None",
                  "Light",
                  "Engaged",
                  "Strong"
                ]
              }
            },
            "required": [
              "account",
              "title"
            ]
          }
        },
        "opportunities": {
          "default": [],
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "externalId": {
                "description": "The record's id in the sending system; keeps identity across re-imports",
